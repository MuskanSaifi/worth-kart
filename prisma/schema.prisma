generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  ONLINE
  UPI
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

model User {
  id            String   @id @default(cuid()) @map("_id")
  name          String?
  email         String   @unique
  phone         String?  @unique
  password      String
  role          Role     @default(BUYER)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  image         String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sellerProfile SellerProfile?
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlist           WishlistItem[]
  otps               Otp[]
  blogs              Blog[]
  pushSubscriptions  PushSubscription[]
}

model SellerProfile {
  id            String       @id @default(cuid()) @map("_id")
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  businessName  String
  businessType  String?
  gstNumber     String?
  gstVerified   Boolean      @default(false)
  gstLegalName  String?
  gstRegisteredMobile String?
  gstFailedAttempts Int      @default(0)
  gstBlockedAt  DateTime?
  gstBlockReason String?
  panNumber     String?
  panVerified   Boolean      @default(false)
  panFailedAttempts Int      @default(0)
  bankAccount   String?
  bankIfsc      String?
  bankVerified  Boolean      @default(false)
  bankAccountHolderName String?
  bankName      String?
  pickupAddress String?
  city          String?
  state         String?
  pincode       String?
  profileImage  String?
  profileImagePublicId String?
  status        SellerStatus @default(PENDING)
  rating        Float        @default(0)
  totalSales    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products      Product[]
  notices       SellerNotice[]
  claims        SellerClaim[]
  returnRequests ReturnRequest[]
  categoryRequests CategoryRequest[]
  activationRequests SellerActivationRequest[]
}

enum ActivationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SellerActivationRequest {
  id        String                  @id @default(cuid()) @map("_id")
  sellerId  String
  seller    SellerProfile           @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message   String
  status    ActivationRequestStatus @default(PENDING)
  adminNote String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

enum QcStatus {
  DRAFT
  QC_IN_PROGRESS
  QC_ERROR
  QC_PASS
  ACTION_REQUIRED
}

model Category {
  id        String     @id @default(cuid()) @map("_id")
  name      String
  slug      String     @unique
  icon      String?
  image     String?
  imagePublicId String?
  keywords  String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  requests CategoryRequest[]
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CategoryRequest {
  id               String                @id @default(cuid()) @map("_id")
  sellerId         String
  seller           SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name             String
  parentCategoryId String?
  parentCategory   Category?             @relation(fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productExample   String?
  status           CategoryRequestStatus @default(PENDING)
  adminNote        String?
  createdCategoryId String?
  createdAt        DateTime              @default(now())
}

model Product {
  id          String         @id @default(cuid()) @map("_id")
  name        String
  slug        String         @unique
  description String
  price       Float
  mrp         Float
  discount    Int            @default(0)
  stock       Int            @default(0)
  sku         String?
  brand       String?
  images      ProductImage[]
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  isDeal      Boolean        @default(false)
  tags        String?
  viewCount   Int            @default(0)
  qcStatus    QcStatus       @default(QC_IN_PROGRESS)
  catalogFileId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
}

model ProductImage {
  id        String  @id @default(cuid()) @map("_id")
  url       String
  publicId  String?
  alt       String?
  isPrimary Boolean @default(false)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Cart {
  id        String     @id @default(cuid()) @map("_id")
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid()) @map("_id")
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Address {
  id        String  @id @default(cuid()) @map("_id")
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  orders    Order[]
}

model Order {
  id                   String        @id @default(cuid()) @map("_id")
  orderNumber          String        @unique
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addressId            String
  address              Address       @relation(fields: [addressId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status               OrderStatus   @default(PENDING)
  paymentMethod        PaymentMethod @default(COD)
  paymentStatus        PaymentStatus @default(PENDING)
  gatewayPaymentId     String?
  subtotal             Float
  discount             Float         @default(0)
  shipping             Float         @default(0)
  total                Float
  estimatedDeliveryAt  DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  deliveryOtpHash      String?
  deliveryOtpExpiresAt DateTime?
  items                OrderItem[]
  events               OrderEvent[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model OrderEvent {
  id        String       @id @default(cuid()) @map("_id")
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status    OrderStatus?
  title     String
  message   String?
  source    String
  createdAt DateTime     @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model OrderItem {
  id        String  @id @default(cuid()) @map("_id")
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int
  price     Float
  sellerId  String
  labelDownloaded Boolean @default(false)
  awbCode               String?
  courierName           String?
  shiprocketOrderId     String?
  shiprocketShipmentId  String?
  trackingUrl           String?
  labelUrl              String?
  shippedAt             DateTime?
  returnRequests ReturnRequest[]
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String  @id @default(cuid()) @map("_id")
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId])
}

model Banner {
  id            String          @id @default(cuid()) @map("_id")
  title         String
  subtitle      String?
  image         String
  imagePublicId String?
  link          String?
  bgColor       String?
  ctaLabel      String?
  /// HERO = top carousel, PROMO = mid offers grid, FOOTER = bottom strip
  placement     String          @default("HERO")
  /// STANDARD = large promo card, COMPACT = small tile (EMI/Exchange style)
  variant       String          @default("STANDARD")
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
}

model Blog {
  id              String   @id @default(cuid()) @map("_id")
  title           String
  slug            String   @unique
  excerpt         String?
  contentHtml     String
  heroImage       String?
  heroImagePublicId String?
  tags            String?
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Footer / info pages (Privacy, Terms, FAQ, etc.) — editable by admin
model SitePage {
  id             String   @id @default(cuid()) @map("_id")
  title          String
  slug           String   @unique
  contentHtml    String
  /// ABOUT | HELP | POLICY
  section        String   @default("ABOUT")
  sortOrder      Int      @default(0)
  showInFooter   Boolean  @default(true)
  isPublished    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Otp {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target    String
  type      String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SellerAnnouncement {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  link        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SellerNotice {
  id        String         @id @default(cuid()) @map("_id")
  sellerId  String?
  seller    SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title     String
  message   String
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ReturnRequest {
  id          String       @id @default(cuid()) @map("_id")
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason      String
  status      ReturnStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model SellerClaim {
  id          String       @id @default(cuid()) @map("_id")
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String
  status      ClaimStatus  @default(OPEN)
  createdAt   DateTime     @default(now())
}
